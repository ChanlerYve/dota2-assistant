# 复制成 .env 后填好再 docker compose up -d
#   cp .env.example .env

# 必填。容器绑定 0.0.0.0，没有 token 就等于公开写接口。
# 生成方式（任选）：
#   openssl rand -hex 24
#   python -c "import secrets;print(secrets.token_hex(24))"
#   PowerShell: -join ((1..48) | %{ '{0:x}' -f (Get-Random -Max 16) })
D2A_API_TOKEN=

# 宿主机映射端口（容器内固定 8787）
D2A_PORT=8787
